#!/usr/bin/env bash

## Main grid: 4 DGP x 3 graphs x 4 training lengths x 100 replications.
export DGP_LIST="${DGP_LIST:-M11,M12,M13,M2}"
export GRAPH_LIST="${GRAPH_LIST:-ER,SBM,SWN}"
export TRAIN_GRID="${TRAIN_GRID:-20,40,80,160}"
export REPLICATIONS="${REPLICATIONS:-100}"

## One job uses one core. All selected methods run sequentially on the same data.
export MAX_JOBS="${MAX_JOBS:-80}"
export TOTAL_CORES="${TOTAL_CORES:-96}"
export CORE_OFFSET="${CORE_OFFSET:-0}"

## Available BGNAR variants:
## bgnar_nondummy
## bgnar_soc_fixed, bgnar_soc_adaptive
## bgnar_dio_fixed, bgnar_dio_adaptive
## bgnar_soc_dio_fixed, bgnar_soc_dio_adaptive
## Other methods: gnar, bvar, rw
export METHODS="${METHODS:-bgnar_soc_dio_adaptive,gnar,bvar}"

## GNAR uses BIC order selection. centered is the requested default; raw is optional.
export GNAR_MODE="${GNAR_MODE:-centered}"
export GNAR_P_MAX="${GNAR_P_MAX:-5}"
export GNAR_S_MAX="${GNAR_S_MAX:-3}"

## BGNAR: fixed p=5, s=(3,3,3,3,3), hierarchical alpha,
## and kappa_alpha ~ IG(3,2).
export BGNAR_P="${BGNAR_P:-5}"
export BGNAR_S="${BGNAR_S:-3,3,3,3,3}"
export MCMC_ITER="${MCMC_ITER:-2000}"
export MCMC_BURN="${MCMC_BURN:-1000}"
export MCMC_THIN="${MCMC_THIN:-2}"
export REDUCE_SOC="${REDUCE_SOC:-1}"

## Fixed tau^2. FIXED_TAU_SCALE=absolute means literal tau^2=1.
## Use pooled to multiply FIXED_TAU2 by the pooled training variance.
export FIXED_TAU2="${FIXED_TAU2:-1}"
export FIXED_TAU_SCALE="${FIXED_TAU_SCALE:-absolute}"

## Adaptive, dimension- and raw-scale-calibrated prior:
## shape = 1 + d/2(1/b-1), scale = a*s_x^2*d/(2b).
export ADAPTIVE_TAU_A="${ADAPTIVE_TAU_A:-2.5}"
export ADAPTIVE_TAU_B="${ADAPTIVE_TAU_B:-1}"

## Every DGP includes a nonzero intercept by default.
## Choices: none, common, nodewise.
export INTERCEPT_MODE="${INTERCEPT_MODE:-common}"
export INTERCEPT_VALUE="${INTERCEPT_VALUE:-0.1}"
export INTERCEPT_SPREAD="${INTERCEPT_SPREAD:-0}"
export INNOVATION_SD="${INNOVATION_SD:-0.316227766}" ## sqrt(0.1)
export DGP_BURN="${DGP_BURN:-300}"
export N_NODES="${N_NODES:-20}"
export FORECAST_HORIZON="${FORECAST_HORIZON:-5}"

## BVAR uses this lag order directly; no BIC selection is performed.
## The legacy variable name BVAR_P_MAX is retained for compatibility.
export BVAR_P_MAX="${BVAR_P_MAX:-5}"
export BVAR_DRAWS="${BVAR_DRAWS:-1000}"
export BVAR_BURN="${BVAR_BURN:-500}"

## Checkpoints are compact. Set to 1 only when full MCMC objects are needed.
export SAVE_FULL_FITS="${SAVE_FULL_FITS:-0}"
export WRITE_POINT_FORECASTS="${WRITE_POINT_FORECASTS:-0}"
export OVERWRITE="${OVERWRITE:-0}"
export STRICT_VALIDATION="${STRICT_VALIDATION:-1}"
export BASE_SEED="${BASE_SEED:-260804}"

## Wind data: raw observations for every method except centered GNAR.
## WIND_METHODS may be shorter than the simulation METHODS list.
export WIND_METHODS="${WIND_METHODS:-$METHODS}"
export WIND_N_STATIONS="${WIND_N_STATIONS:-50}"
export WIND_WINDOW="${WIND_WINDOW:-240}"
export WIND_FIRST_ORIGIN="${WIND_FIRST_ORIGIN:-541}"
export WIND_ORIGIN_SPACING="${WIND_ORIGIN_SPACING:-12}"
export WIND_TAIL_BUFFER="${WIND_TAIL_BUFFER:-12}"
export WIND_N_ORIGINS="${WIND_N_ORIGINS:-15}"
export WIND_MAX_JOBS="${WIND_MAX_JOBS:-15}"
